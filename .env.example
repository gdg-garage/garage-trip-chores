# Copy this file to .env and fill in your secrets.
# The environment variables here follow the 'CHORES_' prefix scheme.

# Logger Configuration
CHORES_LOGGER_LEVEL=debug           # Level of logging (debug, info, warn, error)
CHORES_LOGGER_INCLUDEFILE=true      # Whether to include calling filename and line number in log entries

# Database Configuration (SQLite & Discord Identity)
CHORES_DB_DBPATH=data/db.sqlite      # Path to the SQLite storage file
CHORES_DB_DISCORDTOKEN=???           # [REQUIRED] Your Discord Bot Token
CHORES_DB_DISCORDGUILDID=???        # [REQUIRED] Your Discord Server (Guild) ID
CHORES_DB_PRESENTROLE=chores::present# Name of the Discord role that identifies currently active members
CHORES_DB_SKILLPREFIX=skill::        # Prefix for roles recognized as specialized capabilities/skills

# Chores Logic Details
CHORES_CHORES_OVERSAMPLERATIO=0.5    # Defines candidate count adjustments for automatic assignments

# UI Settings
CHORES_UI_DISCORDCHANNELID=???       # [REQUIRED] The Discord Channel ID where chore announcements appear

# Presence Tracker Settings
CHORES_TRACKER_SAMPLEPERIODMIN=10    # Frequency in minutes to poll Discord for present role updates

# Reminder Task Settings
CHORES_REMINDER_CHECKPERIODSECONDS=2 # Frequency in seconds for calculating assignment expiration/reminders
CHORES_REMINDER_REMINDERATIO=0.1     # Wait ratio before sending automated nudge notifications

# API Settings (REST and WebSocket)
CHORES_API_PORT=8080                 # The HTTP port the API server listens on
CHORES_API_APIKEYS=secret-api-key,another-key # Keys required for secure API/Dashboard communication (supports comma-separated list)

# LLM Summaries (Gemini / Google Cloud)
CHORES_LLM_APIKEY=                   # [OPTIONAL] Google AI / Gemini API Key. If unset, LLM summaries are disabled.
CHORES_LLM_MODEL=gemini-3.7-flash    # Gemini model name (default: gemini-3.7-flash)
CHORES_LLM_SERVICETIER=flex          # Gemini inference service tier: flex (50% cheaper, default), standard, or priority
CHORES_LLM_DISCORDCHANNELID=         # Optional channel ID override for LLM summaries (defaults to CHORES_UI_DISCORDCHANNELID)

# Shifts Management
CHORES_SHIFTS_ADMIN_ROLE=g::t::orgs  # Discord role authorized to manage shift definitions and freeze schedules
CHORES_SHIFTS_FREEZE_HOUR=12         # Hour of day (0-23) when tomorrow's schedule is locked and balanced
CHORES_SHIFTS_DEFAULT_STANDBY_RATIO=0.10 # Standby chore ratio granted for on-call shifts
CHORES_SHIFTS_MAX_SHIFTS_PER_DAY=2   # Max shifts a person should be scheduled per day
CHORES_SHIFTS_TIMEZONE=Europe/Prague # Timezone for shift scheduling
CHORES_SHIFTS_EVENT=gt-8             # Event code to filter registrations

# Registration System Integration (garage-trip-api)
CHORES_REGISTRATION_API_URL=https://api.garage-trip.cz # Base URL of garage-trip-api
CHORES_REGISTRATION_API_KEY=         # API key with org privileges to query /registrations
CHORES_REGISTRATION_EVENT=gt-8       # Event code to filter registrations (e.g. gt-8)
CHORES_REGISTRATION_SYNC_INTERVAL_MIN=15 # Sync frequency in minutes